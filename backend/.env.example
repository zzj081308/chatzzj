# ============================================
# 本地开发配置（Windows + MySQL + FastAPI）
# ============================================
# 复制此文件为 .env，按实际情况修改后启动：
#   uvicorn app.main:app --reload
# ============================================

# ---- MySQL ----
# 格式: mysql+aiomysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 数据库不存在时先手动创建：CREATE DATABASE chatzzj CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/chatzzj?charset=utf8mb4

# ---- JWT 密钥 ----
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret

# ---- 前端地址（CORS 白名单，多个用逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 可选配置 ----
APP_NAME=Chat Room
DEBUG=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
